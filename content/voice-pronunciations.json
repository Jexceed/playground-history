  "notation": "现代标准汉语拼音（带声调）；人名按姓名分词，外国译名单纯标注普通话读法",
  "instructions": [
    "生成正式语音前，逐章对照本表校听人名、地名和多音字。",
    "拼音只帮助编辑判断读音，不替代历史名称本身，也不要求4—6岁儿童识读。",
    "同一汉字在别的词里可能有不同读音；校听时必须按本表登记的完整词语判断。",
    "本表是第一版编辑基线，需在文字冻结、音色定稿和人工试听后再标记为正式定音。"
  ],
  "yearReadingRules": [
    {
      "id": "four-digit-year",
      "example": "1949年",
      "reading": "一九四九年",
      "note": "公元四位年份逐位读，避免读成数量。"
    },
    {
      "id": "year-with-zero",
      "example": "2000年",
      "reading": "二〇〇〇年",
      "note": "年份中的0读líng；书面校音使用“〇”。"
    },
    {
      "id": "bce-year",
      "example": "公元前221年",
      "reading": "公元前二百二十一年",
      "note": "公元前年份按完整数值读，不省略“公元前”。"
    },
    {
      "id": "approximate-bce-year",
      "example": "约前256年",
      "reading": "约公元前二百五十六年",
      "note": "语音补出“公元”，并保留“约”表示年代并非精确日历点。"
    },
    {
      "id": "year-range",
      "example": "1931—1945年",
      "reading": "一九三一年到一九四五年",
      "note": "连接号读作“到”，起止两端都说清“年”。"
    },
    {
      "id": "full-date",
      "example": "1937年7月7日",
      "reading": "一九三七年七月七日",
      "note": "年份逐位读，月日按普通日期读。"
    },
    {
      "id": "century",
      "example": "19世纪",
      "reading": "十九世纪",
      "note": "世纪按数量读，不逐位读成“一九世纪”。"
    }
  ],
