{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/history/chapter-catalog.schema.json",
  "title": "History game chapter catalog",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "trackId", "periods", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "trackId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "editorialNote": { "type": "string" },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "label", "years"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1 },
          "years": { "type": "string", "minLength": 1 },
          "curriculumSections": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "periodId",
          "order",
          "title",
          "coreQuestion",
          "throughline",
          "curriculumRefs",
          "evidencePlan",
          "worldLink",
          "targets",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "periodId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "coreQuestion": { "type": "string", "minLength": 1 },
          "throughline": { "type": "string", "minLength": 1 },
          "curriculumRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidencePlan": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "enum": ["map", "site", "artifact", "document", "inscription", "architecture", "technology", "image", "oral-history", "statistics"] }
          },
          "worldLink": {
            "type": "object",
            "required": ["topic", "status"],
            "additionalProperties": false,
            "properties": {
              "topic": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["planned", "researching", "verified", "not-applicable"] }
            }
          },
          "targets": {
            "type": "object",
            "required": ["durationMinutes", "screens", "audioClips", "interactions"],
            "additionalProperties": false,
            "properties": {
              "durationMinutes": { "type": "integer", "minimum": 3, "maximum": 15 },
              "screens": { "type": "integer", "minimum": 3, "maximum": 8 },
              "audioClips": { "type": "integer", "minimum": 3, "maximum": 10 },
              "interactions": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          },
          "detailPath": { "type": ["string", "null"] },
          "status": {
            "type": "object",
            "required": ["outline", "research", "script", "assets", "audio", "review"],
            "additionalProperties": false,
            "properties": {
              "outline": { "$ref": "#/$defs/status" },
              "research": { "$ref": "#/$defs/status" },
              "script": { "$ref": "#/$defs/status" },
              "assets": { "$ref": "#/$defs/status" },
              "audio": { "$ref": "#/$defs/status" },
              "review": { "$ref": "#/$defs/status" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["not-started", "planned", "in-progress", "first-draft", "verified", "approved", "blocked"]
    }
  }
}
