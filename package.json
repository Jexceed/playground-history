{
  "name": "chronicle-bureau-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:assets": "node scripts/prepare-focused-quests.mjs && node scripts/validate-content.mjs --require-local-assets",
    "content:pack": "node scripts/prepare-focused-quests.mjs && node scripts/validate-content.mjs && node scripts/build-content-pack.mjs && node scripts/generate-content-thumbnails.mjs && node scripts/audit-gameplay-coherence.mjs",
    "content:audit": "node scripts/audit-gameplay-coherence.mjs",
    "content:thumbnails": "node scripts/generate-content-thumbnails.mjs",
    "voice:auditions": "node scripts/generate-voice-auditions.mjs",
    "build": "npm run content:pack && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "voice:generate": "node scripts/generate-voices.mjs",
    "check:local": "npm run content:validate:assets && npm test && npm run lint && npm run typecheck:app",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "voice:update": "npm run content:pack && npm run voice:generate",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "desktop:assets": "node scripts/prepare-desktop-assets.mjs",
    "desktop:dev": "npm run desktop:assets && vite --config vite.desktop.config.ts",
    "desktop:build": "npm run content:pack && npm run desktop:assets && npm run typecheck:desktop && vite build --config vite.desktop.config.ts",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "mac:icon": "node scripts/prepare-mac-icon.mjs",
    "mac:build": "node scripts/macos.mjs build",
    "mac:install": "node scripts/macos.mjs install",
    "mac:package": "node scripts/macos.mjs package",
    "mac:dev": "node scripts/macos.mjs dev"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
