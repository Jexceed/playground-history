  "facts": [
    {
      "number": 1,
      "text": "《春夜喜雨》的作者是杜甫。",
      "sourceIds": [
        "EDB-DUFU-SPRING-RAIN"
      ]
    },
    {
      "number": 2,
      "text": "作品写春天夜里的雨，并以好雨作开篇称呼。",
      "sourceIds": [
        "EDB-DUFU-SPRING-RAIN"
      ]
    },
    {
      "number": 3,
      "text": "随风潜入夜、润物细无声表现细雨在夜间滋润万物。",
      "sourceIds": [
        "EDB-DUFU-SPRING-RAIN"
      ]
    },
    {
      "number": 4,
      "text": "诗中同时写夜色和江船的灯火。",
      "sourceIds": [
        "EDB-DUFU-SPRING-RAIN"
      ]
    },
    {
      "number": 5,
      "text": "诗的结尾将视线转向清晨湿润的花与锦官城。",
      "sourceIds": [
        "EDB-DUFU-SPRING-RAIN"
      ]
    }
  ],
