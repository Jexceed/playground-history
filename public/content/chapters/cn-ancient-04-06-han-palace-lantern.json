    {
      "number": 2,
      "text": "长信宫灯出土于满城中山靖王刘胜妻窦绾墓。",
      "sourceIds": [
        "DPM-CHANGXIN-LAMP"
      ]
    },
    {
      "number": 3,
      "text": "灯具以跪坐持灯的宫女为造型。",
      "sourceIds": [
        "DPM-CHANGXIN-LAMP"
      ]
    },
    {
      "number": 4,
      "text": "宫女右袖形成与灯相连的导烟通道。",
      "sourceIds": [
        "DPM-CHANGXIN-LAMP"
      ]
    },
    {
      "number": 5,
      "text": "灯罩可开合、灯盘可转动，部分构件可以拆卸清理。",
      "sourceIds": [
        "HEBEI-CHANGXIN-STRUCTURE"
      ]
    }
  ],
