  "interactions": [
    {
      "number": 1,
      "title": "把直线变成网络",
      "items": [
        "把长安、关隘、驿站、绿洲和中亚城市连成多条可选路线，遇到风沙或冲突可改道。"
      ]
    },
    {
      "number": 2,
      "title": "驿站值班表",
      "items": [
        "将接待人员、准备马匹、供应粮食、传递文书配到相应岗位，理解基础设施。"
      ]
    },
    {
      "number": 3,
      "title": "物品接力卡",
      "items": [
        "让一件物品经过三次交换，并区分“证据能确认的节点”和“不能编造的主人故事”。"
      ]
    }
