  "interactions": [
    {
      "number": 1,
      "title": "画卷能证明什么",
      "items": [
        "选择“画中有桥、船、店铺”，不选择“全城人口的精确数字”。"
      ]
    },
    {
      "number": 2,
      "title": "市场接力",
      "items": [
        "把生产、运输、店铺、顾客排成物品进入城市的路线。"
      ]
    },
    {
      "number": 3,
      "title": "纸币平衡器",
      "items": [
        "在“轻便”和“需要信用、过量会贬值”两面各放一张卡。"
      ]
    }
